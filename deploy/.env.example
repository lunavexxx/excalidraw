# deploy/.env 模板 —— 复制为 .env 并填值(.env 已 gitignore,不进仓库)
# 服务器与本地各一份,值保持一致(本地 api 要连服务器的 nacos/pg)

# ---- 部署位置与域名(不进 git)----
# 服务器公网 IP:local.yml 的 --nacos-addr、init-nacos.sh、文档命令使用
SERVER_IP=
# 裸域(如 example.cc)与 API 子域(如 api.example.cc):注入 caddy 容器供 Caddyfile 使用
WEB_DOMAIN=
API_DOMAIN=

# PostgreSQL(excalidraw 库)密码。
# 生成:openssl rand -hex 24(用 hex,避免 base64 的 / + 在连接串里需要转义)
# 注意:该密码同时存在于 Nacos 的 database_url 中(由 init-nacos.sh 写入),改密码两处都要改
PG_PASSWORD=

# ---- 应用密钥(由 init-nacos.sh 发布进 Nacos,api 读取)----
# access token 签名密钥(HS256);生成:openssl rand -base64 32
JWT_SECRET=
# 手机号加密主密钥(base64 解码后必须 32 字节):派生 AES-GCM 可逆密文与
# HMAC 查找哈希两组子密钥。生成:openssl rand -base64 32
# 警告:更换后已注册用户的手机号查找/解密全部失效,一经使用不可更换
PHONE_CRYPTO_KEY=

# ---- Nacos 自身鉴权(基础设施自举密钥)----
# JWT 签名密钥,base64 且解码后 >=32 字节;生成:openssl rand -base64 32
# 注意:镜像读取的环境变量名是 NACOS_AUTH_TOKEN(不是 NACOS_AUTH_TOKEN_SECRET)
NACOS_AUTH_TOKEN=
# 服务端身份键值对;生成:openssl rand -hex 8 / openssl rand -hex 16
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# ---- Nacos 客户端登录(api 容器 / init-nacos.sh)----
# 首次部署后进 Nacos 控制台(http://<服务器IP>:8848/nacos)把默认 nacos/nacos
# 改成强密码,再把新账号密码填到这里
NACOS_USERNAME=
NACOS_PASSWORD=
