# Caddy 反向代理(服务器 test.yml 挂载)
# 域名不写死:经环境变量注入(WEB_DOMAIN / API_DOMAIN,来自 deploy/.env,由 compose 传入)
# 证书自动签发/续期,持久化在 caddy-data 卷;www 旧证书(conduit 时代)不迁移,自动重签

{
	# email <你的邮箱>
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

{$WEB_DOMAIN} {
	# api 与 web 同站:前端请求相对路径 /api/v1/*,由这里转发到 Go api,
	# 生产全程同源(无 CORS,认证走 Authorization 头)。
	# 内部端点仅供容器内网(room → api ACL 回调),公网显式拒绝。
	handle /api/v1/internal/* {
		respond 403
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	# 协作 WebSocket(socket.io);Caddy 自动处理 Upgrade。
	handle /socket.io/* {
		reverse_proxy room:3002
	}
	handle {
		reverse_proxy web:80
	}
}

{$API_DOMAIN} {
	reverse_proxy api:8080
}
